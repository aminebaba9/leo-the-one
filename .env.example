# ============================================================================
# Leo's Storefront — Environment Variables Template
# Copy this file to .env locally:  cp .env.example .env
# For Vercel: add these in Project Settings -> Environment Variables
# ============================================================================

# Required: PostgreSQL connection string (Supabase connection pooling URI on port 6543)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# Required: Strong password to protect the /admin panel
ADMIN_PASSWORD="change_this_to_a_secure_admin_password"

# Optional: Public site URL (used in sitemap.xml and robots.txt)
# Example: https://leos-store.vercel.app
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Optional: Server-side tracking tokens
FB_CONVERSIONS_API_TOKEN=""
TIKTOK_ACCESS_TOKEN=""
